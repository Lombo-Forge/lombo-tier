# Required --------------------------------------------------------------
# Where Jellyfin answers, as seen from this container.
LOMBO_TIER_JELLYFIN_URL=https://jellyfin.example.com
# Jellyfin: Dashboard > API Keys > +. One key per app, so you can revoke it alone.
LOMBO_TIER_JELLYFIN_API_KEY=changeme
# Where Jellyfin sees the pool root. A file at /media/movies/X/x.mkv is movies/X/x.mkv in the pool.
LOMBO_TIER_JELLYFIN_PATH_PREFIX=/media
# Folders of the individual disks (NOT the pool mount), comma-separated. Mount them at these same paths.
LOMBO_TIER_SSD_BRANCHES=/mnt/ssd1
LOMBO_TIER_HDD_BRANCHES=/mnt/hdd1,/mnt/hdd2

# Library folders, relative to the pool root, comma-separated ------------
LOMBO_TIER_MOVIE_ROOTS=movies
LOMBO_TIER_SERIES_ROOTS=tv

# Safety ----------------------------------------------------------------
# true = print the plan and move nothing. Set false only after doctor, plan and a dry-run move look right.
LOMBO_TIER_DRY_RUN=true
# Check every branch is mounted before moving anything.
LOMBO_TIER_CHECK_MOUNTS=true
# Optional. If set, a folder with this name must exist inside each branch for it to count as mounted.
# If empty, each branch must be a mount point.
LOMBO_TIER_DISK_MARKER=

# Space (GB) ------------------------------------------------------------
# Keep this free on the SSDs for new files. Set mergerfs minfreespace to the same value.
LOMBO_TIER_RESERVE_GB=40
# Move titles to the HDDs until the SSDs have reserve + headroom free.
LOMBO_TIER_HEADROOM_GB=40
# The destination disk must keep this much free after a move.
LOMBO_TIER_DEST_MARGIN_GB=20
# Most data moved in one run.
LOMBO_TIER_MAX_GB_PER_RUN=600

# Rules -----------------------------------------------------------------
# A title stays on the SSD at least this many days.
LOMBO_TIER_MIN_AGE_DAYS=14
# After coming back to the SSD, a title is not moved down for this many days.
LOMBO_TIER_PIN_DAYS=30
# This many different episodes watched in 7 days brings the season over.
LOMBO_TIER_PROMOTE_EPISODES=2
# A movie played this many times in 30 days comes to the SSD.
LOMBO_TIER_HOT_PLAYS=2
# This many different people watching in 30 days makes a title popular.
LOMBO_TIER_POPULAR_VIEWERS=2
# A viewer counts half as much for every this many days since they watched.
LOMBO_TIER_HALF_LIFE_DAYS=14

# Running ---------------------------------------------------------------
# Where state.json and hdd-index.json live. Mount a volume here.
LOMBO_TIER_DATA_DIR=/data
# Hour (0-23) of the daily run with --loop, in the timezone below.
LOMBO_TIER_RUN_HOUR=4
TZ=UTC
# Stop a run after this long.
LOMBO_TIER_MAX_RUN_MINUTES=240
# Wait up to this long for nobody to be watching before starting.
LOMBO_TIER_WAIT_QUIET_MINUTES=30
# Refresh the saved HDD file list when it is older than this, so sleeping HDDs are not woken every night.
LOMBO_TIER_HDD_INDEX_MAX_DAYS=7

# Optional --------------------------------------------------------------
# Webhook that accepts JSON. Gets a summary of a run that moved something or failed.
LOMBO_TIER_WEBHOOK_URL=
# healthchecks-style URL. GET on success, GET <url>/fail on failure. Never logged.
LOMBO_TIER_PING_URL=
